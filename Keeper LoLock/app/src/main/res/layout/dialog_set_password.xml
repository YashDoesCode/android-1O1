<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_dialog"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/tvPasswordDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/action_set_password"
        android:textColor="@color/silver_white"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="sans-serif"
        android:text="Configures master key derivation with Argon2id. Monitored for 6-month rotation."
        android:textColor="@color/silver_muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etNewPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_amoled_input"
        android:fontFamily="sans-serif"
        android:hint="@string/hint_master_password"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/silver_white"
        android:textColorHint="@color/silver_dark"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_amoled_input"
        android:fontFamily="sans-serif"
        android:hint="@string/hint_confirm_password"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/silver_white"
        android:textColorHint="@color/silver_dark"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSavePassword"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_amoled_btn_silver"
        android:fontFamily="sans-serif-medium"
        android:text="Commit Master Key"
        android:textAllCaps="false"
        android:textColor="@color/amoled_black"
        android:textSize="14sp"
        app:backgroundTint="@null" />

    <TextView
        android:id="@+id/btnDismissPasswordDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif"
        android:padding="8dp"
        android:text="Cancel"
        android:textColor="@color/silver_muted"
        android:textSize="13sp" />
</LinearLayout>
