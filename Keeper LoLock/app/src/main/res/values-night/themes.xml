<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KeeperLoLock" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/silver_main</item>
        <item name="colorPrimaryVariant">@color/silver_dark</item>
        <item name="colorOnPrimary">@color/amoled_black</item>
        <item name="colorSecondary">@color/silver_light</item>
        <item name="colorSecondaryVariant">@color/silver_muted</item>
        <item name="colorOnSecondary">@color/amoled_black</item>
        
        <item name="android:windowBackground">@color/amoled_black</item>
        <item name="android:colorBackground">@color/amoled_black</item>
        <item name="android:statusBarColor">@color/amoled_black</item>
        <item name="android:navigationBarColor">@color/amoled_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.KeeperLoLock.Overlay" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:statusBarColor">@color/amoled_black</item>
        <item name="android:navigationBarColor">@color/amoled_black</item>
    </style>
</resources>