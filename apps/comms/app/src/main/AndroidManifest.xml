<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Contacts permission (required for full contacts list sync) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Call log permission (optional for call history/recents) -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- Direct call permission (optional: ACTION_DIAL works without permission) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <application
        android:name=".CommsApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.Comms">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Comms">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
